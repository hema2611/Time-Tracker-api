# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

DB_HOST=161.97.171.209
DB_PORT=3306
DB_NAME=track_project
DB_USER=tracker
DB_PASSWORD=

# Long random string. Changing it signs everyone out.
JWT_SECRET=
SESSION_HOURS=12

# First Admin/HR user, created by `npm run seed` only when no admin exists.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI reading of proposals. Leave AI_PROVIDER empty to switch AI off.
# gemini = Google AI Studio key (free tier for testing: use sample documents only, Google may use free-tier content).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT_PER_USER=20

GEMINI_FALLBACK_MODEL=gemini-4-hydrogen
AI_TIMEOUT_SECONDS=45
AI_DAILY_CHAT_LIMIT_PER_USER=100

# Email (password reset links). Without SMTP_HOST, local testing prints the email to the API console instead.
# Production must have these set. Address of the web app, used in the links:
WEB_URL=http://localhost:5181
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ImagiNET Tracker <no-reply@imaginetventures.com>"
